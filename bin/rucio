import os
import sys

from rucio.cli.command import main
from rucio.common.config import clean_cached_config, config_get, config_get_list

if __name__ == "__main__":

    multi_host_commands = config_get('client', 'multi_host_commands', raise_exception=False, default='')
    use_multi_host = False
    if "--config" not in sys.argv:
        for arg in sys.argv:
            if arg in [x.strip() for x in multi_host_commands.split(',')]:
                use_multi_host = True

    if use_multi_host:
        multi_host_servers = config_get_list('client', 'multi_host_servers')
        for host in multi_host_servers:
            config = config_get(host, 'config_file')
            clean_cached_config()
            os.environ['RUCIO_CONFIG'] = config
            print('Result from {}.'.format(host))

            main(use_multi_host)
    else:
        main()
